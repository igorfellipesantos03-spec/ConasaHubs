# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Origem exata do frontend (usada no CORS e na checagem de Origin nas mutações)
FRONTEND_ORIGIN=http://localhost:5173

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/centralhub?schema=public

# ─── Sessão ───────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-de-no-minimo-32-caracteres
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=8
# true em produção (exige HTTPS). Em desenvolvimento sobre HTTP, deixe false.
COOKIE_SECURE=false

# ─── Integração TOTVS Protheus ────────────────────────────────────────────────
PROTHEUS_BASE_URL=https://restauth.protheus.conasa.com
PROTHEUS_TIMEOUT_MS=15000
# Empresa/filial usadas no header tenantId ao consultar a tabela SRA
PROTHEUS_DEFAULT_COMPANY=07
PROTHEUS_DEFAULT_BRANCH=01

# ─── Administradores iniciais ─────────────────────────────────────────────────
# Usernames do Protheus promovidos a ADMIN pelo seed (separados por vírgula)
ADMIN_USERNAMES=admin.ti
